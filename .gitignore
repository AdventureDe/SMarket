# ===========================
# 1. 编译构建产物 (Maven)
# ===========================
# 忽略所有模块下的 target 目录（包含 .class, .jar 等）
target/
# 忽略 Maven 包装器（如果不需要提交）
.mvn/
mvnw
mvnw.cmd

# ===========================
# 2. IDE 开发工具配置
# ===========================
# 忽略 IntelliJ IDEA 配置文件
.idea/
*.iml
*.iws
*.ipr

# 忽略 VS Code 或 Eclipse 配置 (以防万一)
.vscode/
.settings/
.classpath
.project

# ===========================
# 3. 运行时数据与日志 (对应你的 data 目录)
# ===========================
# 忽略根目录下的 data 文件夹 (包含 mysql, nacos, redis 数据)
data/
# 忽略各模块可能产生的日志文件
logs/
*.log
*.log.*
*.gz

# ===========================
# 4. 杂项与敏感文件
# ===========================
# 忽略密码文件 (绝对不能提交)
password

# 忽略根目录下的图片文件 (根据你的需求排除非代码文件)
# 如果这些图片是 README 中引用的，请删除下面这几行
*.png
*.jpg
*.jpeg

# 忽略系统自动生成的文件
.DS_Store
Thumbs.db